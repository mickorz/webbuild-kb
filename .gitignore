# 依赖与构建产物
node_modules/
dist/

# macOS
.DS_Store

# Claude Code 本地配置（不进 git）
.claude/settings.local.json

# 抓取沙盒（workspace/）：凭据与抓取产物不入库
# 布局：workspace/common/ 共享依赖；workspace/<站点>/ 每站独立目录
workspace/auth.json
workspace/credentials.json
workspace/inject-ls.json
workspace/archive-*/
workspace/serve.log
workspace/*/auth.json
workspace/*/credentials.json
workspace/*/inject-ls.json
workspace/*/archive-*/
workspace/*/serve.log

# 说明：dev-docs/、dev-examples/、thirdparties/ 均随仓库入库，不要 ignore。
# thirdparties/ 下如需排除某个本地只读目录，在此单独追加该目录条目。
dev-examples/*/tmp/

# 回放回归运行产物（报告 md 入库，证据与临时副本不入库）
workspace/*/regression/.run/
workspace/*/regression/report/evidence/
workspace/*/regression/report/coverage-*.json
# 流式样本可能很大，但属于归档资产：不忽略（如后续体积失控再单独处理）

# E02 差异排查临时归档副本（运行产物）
dev-examples/**/tmp*/
