{
  "port": 8795,
  "scenarios": [
    {
      "id": "S01",
      "name": "入口与控制台初始化",
      "type": "page",
      "path": "/console/console.html",
      "settle": 6000,
      "dom": [
        {
          "sel": ".bc-open"
        }
      ],
      "api": [
        {
          "method": "GET",
          "path": "/api/auth/me",
          "status": 200,
          "fields": {
            "id": "present",
            "email": "present"
          }
        },
        {
          "method": "GET",
          "path": "/api/books",
          "status": 200
        }
      ],
      "expectedFallbacks": [
        {
          "kind": "query-variant-fallback",
          "path": "/console/console.css"
        }
      ]
    },
    {
      "id": "S02",
      "name": "书架数据与书籍列表",
      "type": "page",
      "path": "/console/console.html",
      "settle": 6000,
      "dom": [
        {
          "text": "全球高武"
        }
      ],
      "api": [
        {
          "method": "GET",
          "path": "/api/books",
          "status": 200,
          "fields": {
            "[1].title": "全球高武",
            "[1].id": "2de6cf8f-9b82-4edd-92d1-e0b6611546ec",
            "[0].title": "present"
          }
        }
      ],
      "expectedFallbacks": [
        {
          "kind": "query-variant-fallback",
          "path": "/console/console.css"
        }
      ]
    },
    {
      "id": "S03",
      "name": "世界观总览与维度详情",
      "type": "page",
      "path": "/console/console.html",
      "settle": 5000,
      "steps": [
        {
          "clickCard": "全球高武",
          "wait": 4500
        },
        {
          "click": "[title=\"世界\"]",
          "wait": 4000
        }
      ],
      "dom": [
        {
          "text": "重新编辑世界观"
        }
      ],
      "api": [
        {
          "method": "GET",
          "path": "/api/books/2de6cf8f-9b82-4edd-92d1-e0b6611546ec/world",
          "status": 200
        }
      ],
      "expectedFallbacks": [
        {
          "kind": "query-variant-fallback",
          "path": "/console/console.css"
        }
      ]
    },
    {
      "id": "S04",
      "name": "四步向导进入编辑",
      "type": "page",
      "path": "/console/console.html",
      "settle": 5000,
      "steps": [
        {
          "clickCard": "全球高武",
          "wait": 4500
        },
        {
          "click": "[title=\"世界\"]",
          "wait": 4000
        },
        {
          "clickText": "重新编辑世界观",
          "wait": 4000
        },
        {
          "clickText": "进入编辑",
          "wait": 4000
        }
      ],
      "dom": [
        {
          "sel": ".cr-shell"
        },
        {
          "count": "[class*=\"cr-wbe\"]",
          "gte": 1
        }
      ],
      "expectedFallbacks": [
        {
          "kind": "query-variant-fallback",
          "path": "/console/console.css"
        }
      ]
    },
    {
      "id": "S05",
      "name": "书架助手与会话创建",
      "type": "page",
      "path": "/console/console.html",
      "settle": 5000,
      "steps": [
        {
          "click": ".asst-launch",
          "wait": 5000
        }
      ],
      "dom": [
        {
          "text": "笔枢助手"
        }
      ],
      "api": [
        {
          "method": "POST",
          "path": "/api/assistant/sessions",
          "status": 201,
          "fields": {
            "id": "present",
            "messages[0].content": "contains:笔枢助手"
          }
        }
      ],
      "expectedFallbacks": [
        {
          "kind": "query-variant-fallback",
          "path": "/console/console.css"
        }
      ]
    },
    {
      "id": "E01",
      "name": "书架搜索实测行为（两本书）",
      "type": "page",
      "path": "/console/console.html",
      "settle": 9000,
      "steps": [
        {
          "fill": "input[type=search]",
          "value": "全球",
          "enter": true,
          "wait": 2000,
          "expectText": "全球高武"
        },
        {
          "fill": "input[type=search]",
          "value": "zzz不存在",
          "enter": true,
          "wait": 2500,
          "expectTextAbsent": "全球高武"
        },
        {
          "fill": "input[type=search]",
          "value": "",
          "enter": true,
          "wait": 2000,
          "expectText": "全球高武"
        }
      ],
      "api": [
        {
          "method": "GET",
          "path": "/api/books",
          "status": 200,
          "fields": {
            "[0].title": "present"
          }
        }
      ],
      "expectedFallbacks": [
        {
          "kind": "query-variant-fallback",
          "path": "/console/console.css"
        }
      ],
      "dom": [
        {
          "text": "WBTEST-E02"
        }
      ]
    },
    {
      "id": "E02",
      "name": "新书进书与铸造向导壳渲染（UI）",
      "type": "page",
      "path": "/console/console.html",
      "settle": 6000,
      "steps": [
        {
          "clickCard": "WBTEST-E02",
          "wait": 8000
        }
      ],
      "dom": [
        {
          "sel": ".cr-shell"
        },
        {
          "text": "铸造一个世界"
        }
      ],
      "api": [
        {
          "method": "GET",
          "path": "/api/books/a9379563-e534-4ed3-8996-78b31b1d1bb0/world",
          "status": 200,
          "fields": {
            "dimensions": "present"
          }
        },
        {
          "method": "GET",
          "path": "/api/books/a9379563-e534-4ed3-8996-78b31b1d1bb0/characters",
          "status": 200
        }
      ],
      "expectedFallbacks": [
        {
          "kind": "query-variant-fallback",
          "path": "/console/console.css"
        },
        {
          "kind": "policy-query-ignore",
          "path": "/api/engine-tasks/:id/events"
        }
      ]
    },
    {
      "id": "E03",
      "name": "角色列表与角色详情（只读）",
      "type": "api",
      "requests": [
        {
          "name": "角色列表",
          "method": "GET",
          "path": "/api/books/a9379563-e534-4ed3-8996-78b31b1d1bb0/characters",
          "expect": {
            "status": 200
          }
        },
        {
          "name": "角色详情-沈确",
          "method": "GET",
          "path": "/api/books/a9379563-e534-4ed3-8996-78b31b1d1bb0/characters/%E6%B2%88%E7%A1%AE",
          "expect": {
            "status": 200
          }
        },
        {
          "name": "角色详情-白芷",
          "method": "GET",
          "path": "/api/books/a9379563-e534-4ed3-8996-78b31b1d1bb0/characters/%E7%99%BD%E8%8A%B7",
          "expect": {
            "status": 200
          }
        }
      ]
    },
    {
      "id": "S06",
      "name": "并发相同签名请求 FIFO 确定性",
      "type": "api",
      "requests": [
        {
          "name": "并发6次创建会话（单版本钳位）",
          "method": "POST",
          "path": "/api/assistant/sessions",
          "body": "{}",
          "concurrent": 6,
          "expect": {
            "status": 201,
            "allSameBody": true
          }
        }
      ]
    },
    {
      "id": "S07",
      "name": "未录制与歧义请求诊断",
      "type": "api",
      "requests": [
        {
          "name": "POST未录制端点",
          "method": "POST",
          "path": "/api/definitely-missing",
          "body": "{\"x\":1}",
          "expect": {
            "status": 599
          }
        },
        {
          "name": "GET未录制端点",
          "method": "GET",
          "path": "/api/definitely-missing",
          "expect": {
            "status": 599
          }
        },
        {
          "name": "sessions歧义body拒绝",
          "method": "POST",
          "path": "/api/assistant/sessions",
          "body": "{\"x\":1}",
          "expect": {
            "status": 599
          }
        }
      ],
      "expectKinds": [
        "unmatched",
        "ambiguous-body-variant"
      ]
    }
  ]
}